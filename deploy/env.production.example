# ==========================================================================
# ECPPP — plantilla de variables de entorno para PRODUCCIÓN
# ==========================================================================
# Copiá este archivo como `.env` en la raíz del proyecto EN EL SERVIDOR y
# completá los valores. El `.env` real está en .gitignore y NUNCA se sube.
#
#   cp deploy/env.production.example .env
#   nano .env
#
# Generá la SECRET_KEY con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# ==========================================================================

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REEMPLAZAR_CON_CLAVE_LARGA_Y_ALEATORIA
DJANGO_DEBUG=False
# Dominios/IP permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# Dominio que Caddy usa para el certificado HTTPS (Let's Encrypt).
DJANGO_DOMAIN=example.com
# En producción debe ser 1 para que se junten los archivos estáticos.
DJANGO_COLLECTSTATIC=1

# --- Base de datos (PostgreSQL) -------------------------------------------
# NO definas DATABASE_HOST ni DATABASE_PORT: el compose los fija a db:5432.
DATABASE_NAME=ecppp
DATABASE_USER=ecppp
DATABASE_PASSWORD=REEMPLAZAR_CON_PASSWORD_FUERTE

# --- Caché (Redis) --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- OpenAI (copiloto) ----------------------------------------------------
OPENAI_API_KEY=sk-REEMPLAZAR_CON_TU_KEY
COPILOT_MODEL=gpt-4o-mini

# --- Email (SMTP) --- (reemplazá example.com por tu proveedor real) -------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=usuario@example.com
EMAIL_HOST_PASSWORD=REEMPLAZAR_CON_TU_PASSWORD_SMTP
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Sesión (opcional; defaults en base.py) -------------------------------
# SESSION_TIMEOUT_SECONDS=1200
# SESSION_WARNING_SECONDS=120

# --- Gunicorn (opcional) --------------------------------------------------
GUNICORN_WORKERS=3
